# Environment configuration template for Ledger Financial Intelligence
# Copy this file to .env and adjust variables as required

# Secret key used for signing JWT authentication tokens
JWT_SECRET=ledger-financial-intelligence-jwt-secret-key-2025-secure

# Algorithm for JWT
JWT_ALGORITHM=HS256

# Access token expiration in hours
TOKEN_EXPIRE_HOURS=24

# Server settings
HOST=0.0.0.0
PORT=8000
